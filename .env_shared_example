# Aquest fitxer conté tokens i configuracions que s'utilitzen
# a múltiples projectes del Monorepo.
#
# ⚠️  NO PUJAR A GIT - Conté secrets!
# ============================================

# Notion API
NOTION_TOKEN=ntn_...

# AI/LLM API Keys
HF_API_KEY=gsk_...

# Drupal
SSH_HOST=...
SSH_USER=...
SSH_PASSWORD=...
SSH_PORT=22
SSH_SUWEB_PASSWORD=...
DRUPAL_PATH=/home/ismigar/webapps/web
DRUPAL_URL=https://www.exemple.org

# Drupal Admin Credentials
DRUPAL_ROOT_USER=admin
DRUPAL_ROOT_PASSWORD=...

# n8n
N8N_BASE_URL=http://localhost:5678
N8N_USERNAME=...
N8N_PASSWORD=...
N8N_API_KEY=e...
N8N_API_URL=http://localhost:5678/api/v1

