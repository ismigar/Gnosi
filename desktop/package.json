{
  "name": "@gnosi/desktop",
  "version": "3.0.0-rc.1",
  "description": "Gnosi — local-first, open-source knowledge workspace",
  "homepage": "https://github.com/ismigar/Gnosi",
  "main": "main.js",
  "author": {
    "name": "Ismael Garcia Fernandez",
    "email": "ismigar@gmail.com"
  },
  "license": "MIT",
  "scripts": {
    "test": "node --test *.test.js",
    "typecheck:ipc": "pnpm --filter @gnosi/frontend exec tsc --project ../desktop/tsconfig.ipc.json",
    "test:ipc:smoke": "electron scripts/smoke-ipc.cjs",
    "test:profile:smoke": "node scripts/smoke-profile.cjs",
    "install:runtime": "install-electron",
    "build:icons": "python3 scripts/generate-icons.py",
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "pnpm run build:python && electron-builder --publish never",
    "build:python": "bash build-python.sh",
    "build:mac": "pnpm run build:python && electron-builder --mac --publish never",
    "build:linux": "pnpm run build:python && electron-builder --linux --publish never",
    "build:win": "pnpm run build:python && electron-builder --win --publish never",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "electron-log": "^5.4.4",
    "electron-updater": "^6.1.7",
    "koffi": "3.1.6"
  },
  "devDependencies": {
    "@electron/asar": "4.3.0",
    "electron": "43.4.1",
    "electron-builder": "26.15.3"
  }
}
