<?php

/**
 * @file
 * Installer for the Notion bridge module.
 */

/**
 * Implements hook_schema().
 */
/**
 * Implements hook_schema().
 */
function notion_bridge_schema() {
  $schema['notion_bridge_mapping'] = [
    'description' => 'Tracks the known state of each Notion page and its mapping to a Drupal node.',
    'fields' => [
      'notion_id' => [
        'type' => 'varchar',
        'length' => 64,
        'not null' => TRUE,
        'description' => 'Notion page ID.',
      ],
      'database_id' => [
        'type' => 'varchar',
        'length' => 64,
        'not null' => TRUE,
        'description' => 'Notion database ID.',
      ],
      'nid' => [
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
        'description' => 'Drupal node ID associated with this Notion page.',
      ],
      'last_synced' => [
        'type' => 'datetime',
        'mysql_type' => 'datetime',
        'not null' => TRUE,
        'description' => 'Last time this status was synchronized.',
      ],
    ],
    'primary key' => ['notion_id', 'database_id'],
    'indexes' => [
      'nid' => ['nid'],
      'database_id' => ['database_id'],
    ],
  ];

  return $schema;
}

/**
 * Implements hook_uninstall().
 */
function notion_bridge_uninstall() {
  $schema = \Drupal::database()->schema();
  if ($schema->tableExists('notion_bridge_mapping')) {
    $schema->dropTable('notion_bridge_mapping');
  }

  \Drupal::configFactory()->getEditable('notion_bridge.settings')->delete();
  \Drupal::state()->delete('notion_bridge.last_synced_time');
}
