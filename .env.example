# Gnosi-local configuration. Copy this file to `.env`; never commit `.env`.

# Optional override. Leave unset to use the operating-system application-data path.
# GNOSI_DATA_DIR=/absolute/local/path

# Optional read-only shared environment file. It must be selected explicitly.
# GNOSI_SHARED_ENV_FILE=/absolute/path/.env_shared

# Vault content may live locally or in a synchronized filesystem.
# DIGITAL_BRAIN_VAULT_PATH=/absolute/path/to/vault

# Non-secret service settings may be stored here.
# SOFTCATALA_API_URL=http://localhost:8000

# Save credentials through Gnosi Settings or inject them as process variables.
# Do not put secrets in this example file.
