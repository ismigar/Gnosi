{
  "manifest_version": 3,
  "name": "Gnosi Web Clipper",
  "version": "1.0.0",
  "description": "Desa pàgines web (o la selecció) al teu vault de Gnosi via l'API pública (PAT).",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://localhost/*", "https://localhost/*", "http://127.0.0.1/*", "<all_urls>"],
  "browser_specific_settings": {
    "gecko": {
      "id": "web-clipper@gnosi.app",
      "strict_min_version": "115.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "action": {
    "default_title": "Desa a Gnosi",
    "default_popup": "popup.html"
  }
}
