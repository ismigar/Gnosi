FROM python:3.11-slim

COPY --from=ghcr.io/astral-sh/uv:0.9.15 /uv /uvx /bin/

WORKDIR /app

# Per-device state is separate from the image and from synchronized vaults.
ENV GNOSI_DATA_DIR=/data \
    PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1

# Runtime tools: Docker CLI for MCP, Pandoc for document exports,
# Ghostscript for PDF compression, and the local multimodal LLM Wiki adapters.
RUN apt-get update \
    && apt-get install -y \
        docker.io \
        ffmpeg \
        ghostscript \
        pandoc \
        tesseract-ocr \
        tesseract-ocr-cat \
        tesseract-ocr-eng \
        tesseract-ocr-fra \
        tesseract-ocr-spa \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml uv.lock .python-version ./
COPY extensions/mcp/drupal-proxy/pyproject.toml extensions/mcp/drupal-proxy/pyproject.toml

# Resolve nothing during image creation: synchronize the Linux CPU-only runtime
# directly from the universal lock. Source code is copied later, so workspace
# packages themselves are deliberately omitted while their dependencies remain.
RUN uv sync --frozen --no-cache --no-default-groups --no-install-workspace

# Copy only application roots, never arbitrary checkout-local folders. The
# context exclusions also apply inside these roots. CSL styles are backend data.
COPY backend/ backend/
COPY pipeline/ pipeline/
COPY extensions/ extensions/
COPY config/ config/
COPY frontend/public/csl/ frontend/public/csl/
COPY frontend/package.json frontend/package.json
COPY package.json README.md LICENSE ./

# Expose port
EXPOSE 5002

# Command to run the application
CMD ["uvicorn", "backend.server:app", "--host", "0.0.0.0", "--port", "5002"]
