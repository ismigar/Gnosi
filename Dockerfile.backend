FROM python:3.11-slim

WORKDIR /app

# Runtime tools: Docker CLI for MCP, Pandoc for document exports,
# Ghostscript for PDF compression, and the local multimodal LLM Wiki adapters.
RUN apt-get update \
    && apt-get install -y \
        docker.io \
        ffmpeg \
        ghostscript \
        pandoc \
        tesseract-ocr \
        tesseract-ocr-cat \
        tesseract-ocr-eng \
        tesseract-ocr-fra \
        tesseract-ocr-spa \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
# Docker deployments use CPU inference. Install the CPU-only wheel first so
# sentence-transformers does not pull multi-gigabyte CUDA dependencies into the
# image, especially on the ARM64 CI runner.
ARG TORCH_VERSION=2.12.1
RUN pip install --no-cache-dir \
        --index-url https://download.pytorch.org/whl/cpu \
        "torch==${TORCH_VERSION}+cpu" \
    && pip install --no-cache-dir -r requirements.txt

# Copy the rest of the application
COPY . .

# Expose port
EXPOSE 5002

# Command to run the application
CMD ["uvicorn", "backend.server:app", "--host", "0.0.0.0", "--port", "5002"]
