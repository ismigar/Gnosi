  "scripts": {
    "predev": "if command -v docker >/dev/null 2>&1 && docker ps | grep -q gnosi_frontend; then echo 'ERROR: Docker frontend is already running on port 5173. Stop it first or use Docker.'; exit 1; fi",
    "prebuild": "npm run check:i18n && npm run check:releases",
    "dev": "vite",
    "build": "vite build",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:releases": "node scripts/release-notes.mjs --check",
    "changelog:write": "node scripts/release-notes.mjs --write-changelog",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
