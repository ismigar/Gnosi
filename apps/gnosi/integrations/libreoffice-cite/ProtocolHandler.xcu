<?xml version="1.0" encoding="UTF-8"?>
<!--
  Registra el protocol "gnosicite:" i l'enllaça a la implementació
  com.gnosi.cite.ProtocolHandler (definida a gnosi_cite.py). Quan Writer
  despatxa una URL gnosicite:<cmd>, el framework crea aquesta implementació
  i en crida queryDispatch()/dispatch().
-->
<oor:component-data
    xmlns:oor="http://openoffice.org/2001/registry"
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    oor:name="ProtocolHandler"
    oor:package="org.openoffice.Office">
  <node oor:name="HandlerSet">
    <node oor:name="com.gnosi.cite.ProtocolHandler" oor:op="replace">
      <prop oor:name="Protocols" oor:type="oor:string-list">
        <value>gnosicite:*</value>
      </prop>
    </node>
  </node>
</oor:component-data>
