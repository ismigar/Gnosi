<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Gnosi Cite add-in manifest for Word.

  Minimal TaskpaneApp structure registering an Office add-in with a
  sidebar (TaskPane) and a ribbon button.

  Compatibility:
    - Microsoft Word 2016+ on Windows and Mac
    - Word for iPad/iPhone (partial)
    - Word for the web (https://word.office.com)

  Local sideload installation for development:
    Windows: add \\<server>\share\manifest.xml to Trusted Catalogs
    Mac: copy to ~/Library/Containers/com.microsoft.Word/Data/Documents/wef/
    Web: Insert > Add-ins > Upload My Add-in > select the file

  For production distribution within an organization, publish through
  Microsoft 365 Admin Center > Integrated Apps > Upload custom apps.

  SourceLocation points to the local frontend (5173) in development and to
  the public URL in production. Replace `https://localhost:5173` with the
  final URL before distribution.
-->
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides"
  xsi:type="TaskPaneApp">

  <!-- Unique identifier (GUID). Generate a new one with uuidgen for
       production so every published add-in has its own identifier. -->
  <Id>5e2c8b9a-1f2d-4b3c-9f8e-7d6c5b4a3e2f</Id>
  <!-- Office rejects add-ins with a version below 1.0.0.0, including for
       sideloading. Keep it at or above 1.0.0.0.
       Word only re-reads a sideloaded manifest when the version is NEW: it
       keys its cache on <Id>_<Version>. Dropping a changed manifest that
       keeps the same version is a no-op (the ribbon button never appears).
       Bump this on every released change to the manifest. -->
  <Version>1.3.0.0</Version>
  <ProviderName>Gnosi</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Gnosi Cite" />
  <Description DefaultValue="Search for and insert citations from the Gnosi Vault into a Word document, in the style of Mendeley Cite." />
  <IconUrl DefaultValue="https://localhost:5173/word-addin/assets/icon-32.png?v=3" />
  <HighResolutionIconUrl DefaultValue="https://localhost:5173/word-addin/assets/icon-64.png?v=3" />
  <SupportUrl DefaultValue="https://localhost:5173" />

  <!-- Domains from which the add-in may load resources. Add the final
       production Gnosi URL here. -->
  <AppDomains>
    <AppDomain>https://localhost:5173</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Document" />
  </Hosts>

  <DefaultSettings>
    <SourceLocation DefaultValue="https://localhost:5173/word-addin/index.html" />
  </DefaultSettings>

  <Permissions>ReadWriteDocument</Permissions>

  <!-- VersionOverrides v1.1 integrates the add-in into the Word ribbon
       instead of exposing it only under My Add-ins. -->
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Hosts>
      <Host xsi:type="Document">
        <DesktopFormFactor>
          <GetStarted>
            <Title resid="GetStarted.Title" />
            <Description resid="GetStarted.Description" />
            <LearnMoreUrl resid="GetStarted.LearnMoreUrl" />
          </GetStarted>
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <!-- TabReferences is Word's built-in References tab. The button
                 previously lived under TabHome. -->
            <OfficeTab id="TabReferences">
              <Group id="GnosiCite.Group">
                <Label resid="GnosiCite.GroupLabel" />
                <Icon>
                  <bt:Image size="16" resid="GnosiCite.Icon16" />
                  <bt:Image size="32" resid="GnosiCite.Icon32" />
                  <bt:Image size="80" resid="GnosiCite.Icon80" />
                </Icon>
                <Control xsi:type="Button" id="GnosiCite.OpenTaskpane">
                  <Label resid="GnosiCite.ButtonLabel" />
                  <Supertip>
                    <Title resid="GnosiCite.ButtonLabel" />
                    <Description resid="GnosiCite.ButtonSupertip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="GnosiCite.Icon16" />
                    <bt:Image size="32" resid="GnosiCite.Icon32" />
                    <bt:Image size="80" resid="GnosiCite.Icon80" />
                  </Icon>
                  <!-- TaskpaneId = Office.AutoShowTaskpaneWithDocument marks THIS
                       pane as the one Word reopens by itself for any document
                       tagged with the matching setting (see taskpane.js). It is
                       what lets the pane come back on macOS, where a sideloaded
                       add-in loses its ribbon button as soon as Word quits.
                       Microsoft dropped autoopen for Marketplace add-ins on
                       2026-03-02 but kept it for sideloaded and centrally
                       deployed ones, which is us. Only one pane may carry this
                       id; further ones are ignored. -->
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>Office.AutoShowTaskpaneWithDocument</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url" />
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="GnosiCite.Icon16" DefaultValue="https://localhost:5173/word-addin/assets/icon-16.png?v=3" />
        <bt:Image id="GnosiCite.Icon32" DefaultValue="https://localhost:5173/word-addin/assets/icon-32.png?v=3" />
        <bt:Image id="GnosiCite.Icon80" DefaultValue="https://localhost:5173/word-addin/assets/icon-80.png?v=3" />
      </bt:Images>
      <bt:Urls>
        <bt:Url id="GetStarted.LearnMoreUrl" DefaultValue="https://localhost:5173" />
        <bt:Url id="Taskpane.Url" DefaultValue="https://localhost:5173/word-addin/index.html" />
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GetStarted.Title" DefaultValue="Gnosi Cite" />
        <bt:String id="GnosiCite.GroupLabel" DefaultValue="Gnosi" />
        <bt:String id="GnosiCite.ButtonLabel" DefaultValue="Gnosi Citations" />
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="GetStarted.Description" DefaultValue="Gnosi Cite — insert references from your Vault directly into the document." />
        <bt:String id="GnosiCite.ButtonSupertip" DefaultValue="Open the sidebar to search for and insert citations from the Vault." />
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
