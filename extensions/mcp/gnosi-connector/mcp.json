{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "gnosi": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "--no-project",
        "--with",
        "${PLUGIN_ROOT}",
        "gnosi-connector"
      ],
      "cwd": "${PLUGIN_ROOT}"
    }
  }
}
