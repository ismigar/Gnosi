{
  "manifest_version": 3,
  "name": "Gnosi Web Clipper",
  "version": "1.1.0",
  "description": "Save web pages or selected text to your Gnosi vault through the public API (PAT).",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://localhost/*", "https://localhost/*", "http://127.0.0.1/*", "<all_urls>"],
  "browser_specific_settings": {
    "gecko": {
      "id": "web-clipper@gnosi.app",
      "strict_min_version": "115.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png",
    "512": "icons/icon-512.png"
  },
  "action": {
    "default_title": "Save to Gnosi",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
