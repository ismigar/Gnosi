---
import {site,labels,href,linkProps} from '../lib/site.mjs';
import Newsletter from './Newsletter.astro';
import RenderBlock from './RenderBlock.astro';
import SiteRegions from './SiteRegions.astro';
const {lang}=Astro.props;
const visible=link=>!link.language||link.language===lang;
const legal=link=>/legal|privac|privaci|galetes|cookies/i.test(link.label+' '+link.href);
const collaborate=link=>/col.?labora|colaborar|collaborate|support|donat/i.test(link.label+' '+link.href);
const links=site.footer.filter(visible);
const custom=Array.isArray(site.footer_columns);
const columns=custom?site.footer_columns.filter(column=>!column.language||column.language===lang):[
  {id:'footer-links',alignment:'left',blocks:[{id:'footer-map-links',type:'links',links:[...links.filter(link=>!legal(link)&&!collaborate(link)),{label:labels(lang).map,href:`/${lang}/mapa-web`},{label:'RSS',href:`/${lang}/rss.xml`}]}]},
  {id:'footer-contribution',alignment:'center',blocks:[{id:'footer-contribution-links',type:'links',links:links.filter(collaborate)}]},
  {id:'footer-social-column',alignment:'right',blocks:[{id:'footer-social-profiles',type:'social'}]},
];
const bottom=(site.footer_bottom_links??site.footer.filter(legal)).filter(visible);
const copyright=site.footer_copyright??`© ${site.name}`;
---
<footer class="site-footer" data-pagefind-ignore>
  <SiteRegions lang={lang} position="footer"/>
  {site.footer_blocks==null?(site.legacy_pilot&&<Newsletter lang={lang} instance="footer-newsletter"/>):site.footer_blocks.map(block=><div class:list={["footer-wide",{wrap:block.type!=='newsletter'}]}><RenderBlock block={block} lang={lang} instance={`footer-wide-${block.id}`}/></div>)}
  <div class="wrap">
    {columns.length>0&&<div class="footer-columns" style={`--footer-columns:${columns.length}`}>{columns.map(column=><section class="footer-column" data-align={column.alignment||'left'} data-footer-column={column.id}>
      {column.title&&<h2>{column.title}</h2>}
      {(column.blocks||[]).map(block=><RenderBlock block={block} lang={lang} footer instance={`footer-${column.id}-${block.id}`}/>) }
    </section>)}</div>}
    <div class="footer-bottom">
      {copyright&&<p class="footer-credit">{copyright}{site.legacy_pilot&&site.footer_copyright==null&&<> · <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/deed.ca" target="_blank" rel="noopener noreferrer">CC BY-NC-SA 4.0</a></>}</p>}
      {bottom.length>0&&<nav class="navigation footer-legal">{bottom.map(link=><a href={href(link.href)} {...linkProps(link.href)}>{link.label}</a>)}</nav>}
    </div>
  </div>
</footer>
