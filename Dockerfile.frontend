FROM node:22.22.2-alpine

WORKDIR /app

# The CI job stages the pinned pnpm distribution in the build context. Docker
# therefore does not need to reach the npm registry to bootstrap Corepack.
COPY .ci/pnpm/ /opt/pnpm/
RUN /opt/pnpm/pnpm --version

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY .node-version ./
COPY patches/ patches/
COPY scripts/verify-toolchain.mjs scripts/verify-toolchain.mjs
COPY frontend/package.json frontend/package.json
COPY desktop/package.json desktop/package.json
COPY tests/e2e/package.json tests/e2e/package.json

RUN /opt/pnpm/pnpm install --frozen-lockfile --filter @gnosi/frontend...

# Source is image-owned. Rebuild after code/lock changes; do not mask installed
# workspace dependencies with host node_modules or anonymous dependency volumes.
COPY frontend/ frontend/

WORKDIR /app/frontend

# Expose port
EXPOSE 5173

# Command to run the dev server
CMD ["/opt/pnpm/pnpm", "exec", "vite", "--host", "0.0.0.0", "--port", "5173", "--strictPort"]
