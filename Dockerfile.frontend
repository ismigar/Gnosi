FROM node:22.22.2-alpine AS development

WORKDIR /app

# Install the pinned JavaScript distribution using npm's bounded network retries.
# A clean checkout remains sufficient for both CI and ordinary Compose builds.
RUN npm install --global --ignore-scripts --no-audit --no-fund \
    --fetch-retries=5 --fetch-retry-mintimeout=20000 \
    --fetch-retry-maxtimeout=120000 --fetch-timeout=300000 pnpm@11.19.0 \
    && test "$(pnpm --version)" = "11.19.0"

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY .node-version ./
COPY patches/ patches/
COPY scripts/verify-toolchain.mjs scripts/verify-toolchain.mjs
COPY frontend/package.json frontend/package.json
COPY desktop/package.json desktop/package.json
COPY tests/e2e/package.json tests/e2e/package.json

RUN pnpm install --frozen-lockfile --filter @gnosi/frontend...

# Source is image-owned. Rebuild after code/lock changes; do not mask installed
# workspace dependencies with host node_modules or anonymous dependency volumes.
COPY frontend/ frontend/
# Vite imports this shared verifier when loading its configuration.
COPY desktop/scripts/verify-frontend-assets.cjs desktop/scripts/verify-frontend-assets.cjs
COPY desktop/help-links.json desktop/help-links.json
RUN node -e "require('./desktop/scripts/verify-frontend-assets.cjs')"

WORKDIR /app/frontend

# Expose port
EXPOSE 5173

# Command to run the dev server
CMD ["pnpm", "exec", "vite", "--host", "0.0.0.0", "--port", "5173", "--strictPort"]

# The optional production target builds both application entries and the reader
# from source. Initialize the pinned recursive submodules before Docker builds;
# .dockerignore deliberately excludes Git metadata and host node_modules.
FROM development AS production-build

RUN apk add --no-cache bash curl python3 make g++
COPY scripts/runtime/build-zotero-reader.sh /app/scripts/runtime/build-zotero-reader.sh

ENV npm_config_fetch_retries=5 \
    npm_config_fetch_retry_mintimeout=20000 \
    npm_config_fetch_retry_maxtimeout=120000 \
    npm_config_fetch_timeout=300000 \
    npm_config_audit=false \
    npm_config_fund=false

WORKDIR /app/frontend/vendor/zotero-reader
RUN test -f package-lock.json \
    && test -f src/index.web.js \
    && test -f pdfjs/pdf.js/package-lock.json \
    && test -f epubjs/epub.js/src/index.js \
    && test -d structured-document-text/src \
    || (echo 'Initialize pinned reader sources: git submodule update --init --recursive' >&2; exit 1)
# Never accept ignored host build outputs as the production reader prerequisite.
RUN rm -rf build locales pdfjs/pdf.js/build /app/frontend/public/zotero-reader \
    && NODE_OPTIONS=--openssl-legacy-provider npm ci \
    && bash /app/scripts/runtime/build-zotero-reader.sh

WORKDIR /app/frontend
# Browser API clients use location.origin; backend:5002 is only an nginx upstream.
# The offline shell currently supports deployment at the origin root.
ENV VITE_BASE_PATH=/ VITE_API_URL=""
RUN pnpm exec vite build && node scripts/check-bundle-size.ts

FROM nginx:1.30.5-alpine3.24 AS production
COPY docker/frontend-production.conf /etc/nginx/conf.d/default.conf
COPY --from=production-build /app/frontend/dist /usr/share/nginx/html
EXPOSE 5173
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD wget -q --spider http://127.0.0.1:5173/offline.html || exit 1

# Keep ordinary docker-compose.yml and existing CI images on the Vite workflow.
FROM development AS default
