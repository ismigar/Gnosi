FROM node:22.22.2-alpine

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@11.19.0 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY .node-version ./
COPY patches/ patches/
COPY scripts/verify-toolchain.mjs scripts/verify-toolchain.mjs
COPY frontend/package.json frontend/package.json
COPY desktop/package.json desktop/package.json
COPY tests/e2e/package.json tests/e2e/package.json

RUN pnpm install --frozen-lockfile --filter @gnosi/frontend...

# Source is image-owned. Rebuild after code/lock changes; do not mask installed
# workspace dependencies with host node_modules or anonymous dependency volumes.
COPY frontend/ frontend/

WORKDIR /app/frontend

# Expose port
EXPOSE 5173

# Command to run the dev server
CMD ["pnpm", "exec", "vite", "--host", "0.0.0.0", "--port", "5173", "--strictPort"]
